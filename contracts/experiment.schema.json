{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "experiment.schema.json",
  "title": "Experiment",
  "description": "An experiment with its plan, results, verdict and history.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "state",
    "statement",
    "source",
    "car_name",
    "track_name",
    "parameter",
    "parameter_label",
    "clicks",
    "driver",
    "success_test",
    "guardrails",
    "predictions",
    "arms",
    "blocks",
    "results",
    "events",
    "extensions",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "ofat",
        "factorial",
        "recheck",
        "base"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "running",
        "evaluating",
        "accepted",
        "rejected",
        "tradeoff",
        "inconclusive",
        "reverted",
        "aborted",
        "discarded"
      ]
    },
    "statement": {
      "description": "The hypothesis in words.",
      "type": "string"
    },
    "source": {
      "description": "Where the hypothesis came from: the diagnosis rules, a language model, or the human.",
      "type": "string",
      "enum": [
        "rules",
        "llm",
        "human"
      ]
    },
    "car_name": {
      "type": "string"
    },
    "driver": {
      "description": "Who drives the laps: the human, or AC's AI on the player's car (Ghost Driver, docs/adr/0014-ghost-driver.md).",
      "type": "string",
      "enum": [
        "human",
        "ai"
      ]
    },
    "purpose": {
      "description": "Why the experiment was driven (docs/adr/0032-sensitivity-discovery-sweeps.md): improve the setup (the champion follows the verdict), sweep (a step of a sensitivity sweep: measured, never promoted), or recheck (the champion against the original baseline).",
      "type": "string",
      "enum": [
        "improve",
        "sweep",
        "recheck"
      ]
    },
    "track_name": {
      "type": "string"
    },
    "parameter": {
      "description": "Setup item that is changed.",
      "type": "string"
    },
    "parameter_label": {
      "description": "What the setup menu calls it.",
      "type": "string"
    },
    "clicks": {
      "description": "Clicks the variant moves it; negative is down.",
      "type": "integer"
    },
    "success_test": {
      "$ref": "#/definitions/SuccessTest"
    },
    "guardrails": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/GuardrailSpec"
      }
    },
    "predictions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PredictionSpec"
      }
    },
    "arms": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ExperimentArm"
      }
    },
    "plan": {
      "$ref": "#/definitions/PlanSummary"
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ExperimentBlock"
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ExperimentResult"
      }
    },
    "responses": {
      "description": "What the car did: the latest engine verdict's response findings on the cells the changed parameter is expected to move (ADR 0034). Absent or empty for experiments judged before.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/ExperimentResponse"
      }
    },
    "verdict": {
      "$ref": "#/definitions/VerdictSummary"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ExperimentEvent"
      }
    },
    "extensions": {
      "description": "Times the plan was extended after an inconclusive result (at most 2).",
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "description": "RFC 3339, UTC.",
      "type": "string"
    }
  },
  "definitions": {
    "SuccessTest": {
      "title": "SuccessTest",
      "description": "The test an experiment must pass, fixed before driving.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "rope",
        "level",
        "better"
      ],
      "properties": {
        "channel": {
          "description": "Metric id of the primary response.",
          "type": "string",
          "minLength": 1
        },
        "rope": {
          "description": "Half-width of the band of effects too small to matter, in the channel's unit.",
          "type": "number",
          "minimum": 0
        },
        "level": {
          "description": "Confidence level of the interval.",
          "type": "number",
          "exclusiveMinimum": 0.5,
          "exclusiveMaximum": 1
        },
        "better": {
          "description": "Which direction is an improvement.",
          "type": "string",
          "enum": [
            "lower",
            "higher"
          ]
        }
      }
    },
    "GuardrailSpec": {
      "title": "GuardrailSpec",
      "description": "A channel that must not get worse by more than a tolerance.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "tolerance",
        "worse"
      ],
      "properties": {
        "channel": {
          "description": "Metric id.",
          "type": "string",
          "minLength": 1
        },
        "tolerance": {
          "description": "Allowed change in the bad direction, in the channel's unit.",
          "type": "number",
          "minimum": 0
        },
        "worse": {
          "description": "Which direction is bad.",
          "type": "string",
          "enum": [
            "higher",
            "lower"
          ]
        }
      }
    },
    "PredictionSpec": {
      "title": "PredictionSpec",
      "description": "What the hypothesis expects of one channel, written before driving.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "direction",
        "low",
        "high"
      ],
      "properties": {
        "channel": {
          "description": "Metric id.",
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "decrease",
            "increase"
          ]
        },
        "low": {
          "description": "Smallest expected size of the change.",
          "type": "number",
          "minimum": 0
        },
        "high": {
          "description": "Largest expected size of the change.",
          "type": "number",
          "minimum": 0
        }
      }
    },
    "ExperimentArm": {
      "title": "ExperimentArm",
      "description": "One setup of the experiment.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "is_baseline",
        "setup_version_id",
        "value"
      ],
      "properties": {
        "label": {
          "description": "Code name shown to the driver.",
          "type": "string"
        },
        "is_baseline": {
          "type": "boolean"
        },
        "setup_version_id": {
          "type": "integer",
          "minimum": 1
        },
        "value": {
          "description": "Raw value of the changed item on this arm.",
          "type": "number"
        }
      }
    },
    "PlanSummary": {
      "title": "PlanSummary",
      "description": "What the plan can answer, computed before driving.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sigma",
        "sigma_source",
        "passes_per_arm",
        "mde_detect",
        "mde_decide"
      ],
      "properties": {
        "sigma": {
          "type": "number",
          "minimum": 0
        },
        "sigma_source": {
          "type": "string",
          "enum": [
            "measured",
            "assumed"
          ]
        },
        "passes_per_arm": {
          "type": "integer",
          "minimum": 1
        },
        "mde_detect": {
          "type": "number",
          "minimum": 0
        },
        "mde_decide": {
          "type": "number",
          "minimum": 0
        },
        "sigma_lap": {
          "type": "number",
          "minimum": 0
        },
        "sigma_lap_source": {
          "type": "string",
          "enum": [
            "planned",
            "free",
            "none"
          ]
        },
        "mde_target": {
          "type": "number",
          "minimum": 0
        },
        "target_met": {
          "type": "boolean"
        }
      }
    },
    "ExperimentBlock": {
      "title": "ExperimentBlock",
      "description": "One block of the run plan and how much of it is driven.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "label",
        "laps_target",
        "laps_done",
        "passes"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "description": "Code name of the setup to load.",
          "type": "string"
        },
        "laps_target": {
          "type": "integer",
          "minimum": 0
        },
        "laps_done": {
          "description": "Push laps finished in this block: the last one counts once it reached every corner, the next block started or nothing arrived for 15 minutes (the out-lap does not count).",
          "type": "integer",
          "minimum": 0
        },
        "passes": {
          "description": "Corner passes recorded in this block.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ExperimentResult": {
      "title": "ExperimentResult",
      "description": "The measured effect on one channel.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "role",
        "corner_class",
        "estimate",
        "ci_low",
        "ci_high",
        "n_passes",
        "effect_class"
      ],
      "properties": {
        "channel": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "primary",
            "guardrail",
            "driver_input",
            "prediction"
          ]
        },
        "corner_class": {
          "type": "string",
          "enum": [
            "all",
            "slow",
            "medium",
            "fast"
          ]
        },
        "estimate": {
          "type": "number"
        },
        "ci_low": {
          "type": "number"
        },
        "ci_high": {
          "type": "number"
        },
        "n_passes": {
          "type": "integer",
          "minimum": 0
        },
        "effect_class": {
          "type": "string",
          "enum": [
            "positive",
            "negative",
            "negligible",
            "inconclusive"
          ]
        }
      }
    },
    "VerdictSummary": {
      "title": "VerdictSummary",
      "description": "How the experiment ended.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason",
        "decided_by",
        "decided_at",
        "prediction_hits",
        "prediction_total"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected",
            "tradeoff",
            "inconclusive",
            "reverted",
            "aborted"
          ]
        },
        "reason": {
          "type": "string"
        },
        "decided_by": {
          "description": "engine: the statistics. driver: the human. training: an AI training program's rule (docs/adr/0020-ai-training-program.md).",
          "type": "string",
          "enum": [
            "engine",
            "driver",
            "training"
          ]
        },
        "decided_at": {
          "description": "RFC 3339, UTC.",
          "type": "string"
        },
        "prediction_hits": {
          "type": "integer",
          "minimum": 0
        },
        "prediction_total": {
          "type": "integer",
          "minimum": 0
        },
        "finding_class": {
          "description": "What the experiment found on the primary channel (ADR 0029), orthogonal to the decision: invalid, confirmed improvement or regression (the whole interval beyond the margin, at least 8 blocks), neutral (the interval inside the margin), context-dependent (the effect differs between speed classes), likely improvement or regression (the interval excludes zero), insufficient evidence. From the latest verdict the engine gave.",
          "type": "string",
          "enum": [
            "invalid",
            "confirmed_improvement",
            "confirmed_regression",
            "neutral",
            "context_dependent",
            "likely_improvement",
            "likely_regression",
            "insufficient_evidence"
          ]
        },
        "finding_derived": {
          "description": "True when the finding was derived from an old verdict's decision and reason (judged before ADR 0029, by another method).",
          "type": "boolean"
        },
        "flags": {
          "description": "few_blocks: fewer than 8 blocks, never a confirmed finding. uninformative: the interval is more than twice the margin wide on each side.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "few_blocks",
              "uninformative"
            ]
          }
        },
        "recommendation": {
          "description": "What to do next (ADR 0029): continue to the next look, test a larger step, investigate a speed class, switch the primary metric (time neutral, response moved), stop (nothing to gain), stop (invalid). Absent when the finding is confirmed.",
          "type": "string",
          "enum": [
            "continue",
            "larger_perturbation",
            "investigate_context",
            "switch_metric",
            "stop_neutral",
            "stop_invalid"
          ]
        },
        "confounders": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Confounder"
          }
        },
        "driver_adapted": {
          "type": "boolean"
        },
        "engine_version": {
          "type": "string"
        },
        "passes_used": {
          "type": "integer",
          "minimum": 0
        },
        "passes_excluded": {
          "type": "integer",
          "minimum": 0
        },
        "look": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "margin": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "ExperimentEvent": {
      "title": "ExperimentEvent",
      "description": "One state transition.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "reason",
        "at"
      ],
      "properties": {
        "from": {
          "description": "State before; empty for the creation.",
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "at": {
          "description": "RFC 3339, UTC.",
          "type": "string"
        }
      }
    },
    "Confounder": {
      "title": "Confounder",
      "description": "Something besides the setup that may be in the number, named for the reader.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "covariate_left_out",
            "covariate_between_blocks",
            "driver_input_shifted",
            "session_tangled",
            "setup_mismatch",
            "source_mismatch",
            "speed_class_interaction",
            "phase_interaction"
          ]
        },
        "name": {
          "description": "The covariate, channel, speed classes or reason it is about.",
          "type": "string",
          "minLength": 1
        },
        "count": {
          "description": "Passes concerned, for the exclusions.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ExperimentResponse": {
      "title": "ExperimentResponse",
      "description": "One stored response finding (result row of role response).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "phase",
        "regime",
        "expected",
        "finding",
        "estimate",
        "ci_low",
        "ci_high",
        "margin",
        "n_passes"
      ],
      "properties": {
        "metric": {
          "type": "string"
        },
        "phase": {
          "title": "ExperimentResponsePhase",
          "type": "string",
          "enum": [
            "braking",
            "entry",
            "mid",
            "exit",
            "traction",
            "corner"
          ]
        },
        "regime": {
          "title": "ExperimentResponseRegime",
          "type": "string",
          "enum": [
            "all",
            "slow",
            "medium",
            "fast"
          ]
        },
        "expected": {
          "title": "ExperimentResponseExpected",
          "type": "string",
          "enum": [
            "direct",
            "proxy"
          ]
        },
        "finding": {
          "title": "ExperimentResponseFinding",
          "type": "string",
          "enum": [
            "increase",
            "decrease",
            "neutral",
            "likely_increase",
            "likely_decrease",
            "insufficient"
          ]
        },
        "estimate": {
          "type": "number"
        },
        "ci_low": {
          "type": "number"
        },
        "ci_high": {
          "type": "number"
        },
        "margin": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "n_passes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
