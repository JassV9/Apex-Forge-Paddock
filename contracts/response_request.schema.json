{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "response_request.schema.json",
  "title": "ResponseRequest",
  "description": "Asks the engine how an experiment's variant changed the car's response, per phase and speed regime (POST /response, ADR 0031).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "track_length_m",
    "corners",
    "sessions",
    "passes"
  ],
  "properties": {
    "track_length_m": {
      "description": "Lap length along the AI line.",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "level": {
      "description": "Confidence level of every interval; 0.9 when left out.",
      "type": "number",
      "exclusiveMinimum": 0.5,
      "exclusiveMaximum": 1
    },
    "item_role": {
      "description": "The changed setup item's role in the catalog (arb, wing, bias, ...); picks the parameter row of the observables mapping.",
      "type": "string"
    },
    "item_axle": {
      "description": "F or R when the changed item belongs to one axle; empty otherwise.",
      "type": "string"
    },
    "corners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "ResponseCorner",
        "description": "Where a corner and its zone are, in metres from the start line.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "zone_start_m",
          "start_m",
          "end_m",
          "zone_end_m"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "zone_start_m": {
            "type": "number",
            "minimum": 0
          },
          "start_m": {
            "type": "number",
            "minimum": 0
          },
          "end_m": {
            "type": "number",
            "minimum": 0
          },
          "zone_end_m": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "sessions": {
      "description": "Where each session's raw samples are.",
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "ResponseSession",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session",
          "parquet_dir"
        ],
        "properties": {
          "session": {
            "type": "integer",
            "minimum": 1
          },
          "parquet_dir": {
            "description": "Directory of the session's Parquet parts.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "passes": {
      "type": "array",
      "items": {
        "title": "ResponsePass",
        "description": "One pass of the experiment's push laps.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session",
          "seq",
          "corner",
          "arm",
          "block",
          "t_start_s",
          "duration_s",
          "valid"
        ],
        "properties": {
          "session": {
            "type": "integer",
            "minimum": 1
          },
          "seq": {
            "description": "Order of the pass within its session.",
            "type": "integer",
            "minimum": 1
          },
          "corner": {
            "type": "integer",
            "minimum": 1
          },
          "arm": {
            "type": "string",
            "enum": [
              "baseline",
              "variant"
            ]
          },
          "block": {
            "type": "integer",
            "minimum": 1
          },
          "lap": {
            "description": "Lap code; passes of one lap share their errors.",
            "type": "integer",
            "minimum": 0
          },
          "t_start_s": {
            "description": "When the pass started, seconds on any clock shared by the session's passes.",
            "type": "number"
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "valid": {
            "description": "False: not compared, but its samples may still complete the previous pass's exit and traction.",
            "type": "boolean"
          },
          "covariates": {
            "description": "Conditions to adjust for, as in EvaluatePass.",
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
