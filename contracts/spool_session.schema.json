{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spool_session.schema.json",
  "title": "SpoolSession",
  "description": "First line of a session in the spool: which car, which track, and the corner map every pass refers to. Written by the agent, read by core's ingest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "v",
    "session_id",
    "started_at_ms",
    "source",
    "agent_version",
    "car",
    "track"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "session"
      ]
    },
    "v": {
      "description": "Format version of this line.",
      "type": "integer",
      "enum": [
        1
      ]
    },
    "session_id": {
      "description": "Unique per agent run; also the spool directory name.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "started_at_ms": {
      "description": "Wall clock when the session started, Unix milliseconds.",
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "description": "Who drove.",
      "type": "string",
      "enum": [
        "human",
        "ai",
        "ghost",
        "demo"
      ]
    },
    "agent_version": {
      "type": "string",
      "minLength": 1
    },
    "car": {
      "title": "SpoolCar",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ac_id",
        "name"
      ],
      "properties": {
        "ac_id": {
          "description": "Assetto Corsa car folder name.",
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        }
      }
    },
    "track": {
      "title": "SpoolTrack",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ac_id",
        "layout",
        "name",
        "length_m",
        "corner_map_version",
        "corners"
      ],
      "properties": {
        "ac_id": {
          "description": "Assetto Corsa track folder name.",
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "description": "Layout folder name; empty for single-layout tracks.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "length_m": {
          "description": "Lap length along the AI line.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "corner_map_version": {
          "description": "Version of the corner-detection algorithm.",
          "type": "integer",
          "minimum": 1
        },
        "corners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/SpoolCorner"
          }
        }
      }
    },
    "context": {
      "title": "SessionContext",
      "description": "What the session was driven under (docs/adr/0028-run-context-and-ai-provenance.md). Absent in sessions recorded before the agent sent it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cars_count",
        "ai"
      ],
      "properties": {
        "cars_count": {
          "description": "Cars in the session (CSP ac.StateSim.carsCount).",
          "type": "integer",
          "minimum": 1
        },
        "csp_version": {
          "description": "CSP's version (ac.getPatchVersion).",
          "type": "string"
        },
        "csp_build": {
          "description": "CSP's build number (ac.getPatchVersionCode).",
          "type": "integer"
        },
        "ai": {
          "title": "SessionAi",
          "description": "The AI's settings on the player's car when the session started. In a human session: what the AI would drive with.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tyre_hint_base",
            "learned_share"
          ],
          "properties": {
            "tyre_hint_base": {
              "description": "The car's own AI tyre hint, ai.ini [TYRES] HINT.",
              "type": "number"
            },
            "learned_share": {
              "description": "Share of the car's own AI tyre hint (ai.ini [TYRES] HINT) the calibration learned (ai_tune file).",
              "type": "number"
            },
            "pinned_share": {
              "description": "Share of the car's own AI tyre hint (ai.ini [TYRES] HINT) pinned by the run plan or the free-lap command; only in an AI session.",
              "type": "number"
            },
            "applied_hint": {
              "description": "Tyre hint the AI drives with: tyre_hint_base times the pinned share, else the learned one; only in an AI session.",
              "type": "number"
            },
            "extra_grip": {
              "description": "Extra AI grip the agent sets while the AI drives (1: the car's own grip); only in an AI session.",
              "type": "number"
            },
            "aero_hint": {
              "description": "ai.ini [PHYSICS_HINTS] AERO_HINT, when the file has one.",
              "type": "number"
            },
            "brake_hint": {
              "description": "ai.ini [PEDALS] BRAKE_HINT, when the file has one.",
              "type": "number"
            },
            "level": {
              "description": "AI level, 0..1, -1 without AI (ac.StateCar.aiLevel).",
              "type": "number"
            },
            "aggression": {
              "description": "AI aggression, 0..1, -1 without AI (ac.StateCar.aiAggression).",
              "type": "number"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "SpoolCorner": {
      "title": "SpoolCorner",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "name",
        "direction",
        "start_m",
        "end_m",
        "apex_m",
        "radius_m",
        "angle_deg",
        "zone_start_m",
        "zone_end_m"
      ],
      "properties": {
        "number": {
          "description": "1-based, counted from the start line.",
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": [
            "L",
            "R"
          ]
        },
        "start_m": {
          "description": "Where the corner itself starts (radius drops below the threshold), metres from the start line.",
          "type": "number",
          "minimum": 0
        },
        "end_m": {
          "description": "Where the corner itself ends.",
          "type": "number",
          "minimum": 0
        },
        "apex_m": {
          "description": "Tightest point, metres from the start line.",
          "type": "number",
          "minimum": 0
        },
        "radius_m": {
          "description": "Radius at the apex.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "angle_deg": {
          "description": "Total change of heading through the corner.",
          "type": "number",
          "minimum": 0
        },
        "zone_start_m": {
          "description": "Where a pass of this corner starts (includes the braking area).",
          "type": "number",
          "minimum": 0
        },
        "zone_end_m": {
          "description": "Where a pass of this corner ends (includes the traction area).",
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
