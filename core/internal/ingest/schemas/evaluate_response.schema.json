{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "evaluate_response.schema.json",
  "title": "EvaluateResponse",
  "description": "The engine's verdict on an experiment, with the numbers behind it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "reason",
    "results",
    "guardrails",
    "prediction_hits",
    "prediction_total",
    "driver_adapted",
    "passes_used",
    "passes_excluded"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected",
        "tradeoff",
        "inconclusive"
      ]
    },
    "reason": {
      "description": "One sentence a person can read.",
      "type": "string",
      "minLength": 1
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ChannelResult"
      }
    },
    "guardrails": {
      "type": "array",
      "items": {
        "title": "GuardrailResult",
        "description": "Whether one guardrail held.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel",
          "status"
        ],
        "properties": {
          "channel": {
            "description": "Metric id.",
            "type": "string",
            "minLength": 1
          },
          "status": {
            "description": "holds: within tolerance. moved: the estimate is past the tolerance but the interval is not. broke: the whole interval is past it. unknown: not enough data.",
            "type": "string",
            "enum": [
              "holds",
              "moved",
              "broke",
              "unknown"
            ]
          }
        }
      }
    },
    "prediction_hits": {
      "description": "Predictions whose direction came true.",
      "type": "integer",
      "minimum": 0
    },
    "prediction_total": {
      "description": "Predictions that could be checked.",
      "type": "integer",
      "minimum": 0
    },
    "driver_adapted": {
      "description": "True when a driver-input channel shifted between the setups: the effect may be the driver, not the car.",
      "type": "boolean"
    },
    "passes_used": {
      "type": "integer",
      "minimum": 0
    },
    "passes_excluded": {
      "description": "Passes left out: missing the primary channel, plus those core excluded (setup or driver mismatch). Off-track passes are counted in the offtrack_rate guardrail instead.",
      "type": "integer",
      "minimum": 0
    },
    "finding_class": {
      "description": "What the experiment found on the primary channel (ADR 0029), orthogonal to the decision: invalid, confirmed improvement or regression (the whole interval beyond the margin, at least 8 blocks), neutral (the interval inside the margin), context-dependent (the effect differs between speed classes), likely improvement or regression (the interval excludes zero), insufficient evidence.",
      "type": "string",
      "enum": [
        "invalid",
        "confirmed_improvement",
        "confirmed_regression",
        "neutral",
        "context_dependent",
        "likely_improvement",
        "likely_regression",
        "insufficient_evidence"
      ]
    },
    "flags": {
      "description": "few_blocks: fewer than 8 blocks, never a confirmed finding. uninformative: the interval is more than twice the margin wide on each side.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "few_blocks",
          "uninformative"
        ]
      }
    },
    "recommendation": {
      "description": "What to do next (ADR 0029): continue to the next look, test a larger step, investigate a speed class, switch the primary metric (time neutral, response moved), stop (nothing to gain), stop (invalid). Absent when the finding is confirmed.",
      "type": "string",
      "enum": [
        "continue",
        "larger_perturbation",
        "investigate_context",
        "switch_metric",
        "stop_neutral",
        "stop_invalid"
      ]
    },
    "look": {
      "description": "The look this verdict was judged at (ADR 0029).",
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "margin": {
      "description": "Margin of practical equivalence the finding was judged against, in the primary channel's unit.",
      "type": "number",
      "minimum": 0
    },
    "confounders": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Confounder"
      }
    },
    "engine_version": {
      "description": "Version of the engine that computed the numbers (ADR 0030).",
      "type": "string",
      "minLength": 1
    }
  },
  "definitions": {
    "ChannelResult": {
      "title": "ChannelResult",
      "description": "The variant's effect on one channel: variant minus baseline per corner pass.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "role",
        "corner_class",
        "estimate",
        "ci_low",
        "ci_high",
        "n_passes",
        "effect_class"
      ],
      "properties": {
        "channel": {
          "description": "Metric id.",
          "type": "string",
          "minLength": 1
        },
        "role": {
          "description": "Why the channel was evaluated.",
          "type": "string",
          "enum": [
            "primary",
            "guardrail",
            "driver_input",
            "prediction"
          ]
        },
        "corner_class": {
          "description": "all, or the speed class the estimate is restricted to.",
          "type": "string",
          "enum": [
            "all",
            "slow",
            "medium",
            "fast"
          ]
        },
        "estimate": {
          "description": "Variant minus baseline.",
          "type": "number"
        },
        "ci_low": {
          "description": "Lower end of the interval.",
          "type": "number"
        },
        "ci_high": {
          "description": "Upper end of the interval.",
          "type": "number"
        },
        "n_passes": {
          "description": "Passes used, both arms.",
          "type": "integer",
          "minimum": 0
        },
        "effect_class": {
          "type": "string",
          "enum": [
            "positive",
            "negative",
            "negligible",
            "inconclusive"
          ]
        }
      }
    },
    "Confounder": {
      "title": "Confounder",
      "description": "Something besides the setup that may be in the number, named for the reader.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "covariate_left_out",
            "covariate_between_blocks",
            "driver_input_shifted",
            "session_tangled",
            "setup_mismatch",
            "source_mismatch",
            "speed_class_interaction"
          ]
        },
        "name": {
          "description": "The covariate, channel, speed classes or reason it is about.",
          "type": "string",
          "minLength": 1
        },
        "count": {
          "description": "Passes concerned, for the exclusions.",
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
