{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "plan_request.schema.json",
  "title": "PlanRequest",
  "description": "Core asks the engine what a run plan can detect (POST /plan).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "success_test",
    "corners",
    "laps_per_block",
    "baseline_passes"
  ],
  "properties": {
    "success_test": {
      "$ref": "#/definitions/SuccessTest"
    },
    "corners": {
      "description": "Corner numbers of the track.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "laps_per_block": {
      "description": "Push laps per block.",
      "type": "integer",
      "minimum": 1
    },
    "baseline_passes": {
      "description": "The primary channel on earlier valid passes of the baseline setup; empty when there are none.",
      "type": "array",
      "items": {
        "title": "PlanPass",
        "description": "One earlier pass.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "corner",
          "value"
        ],
        "properties": {
          "corner": {
            "type": "integer",
            "minimum": 1
          },
          "value": {
            "description": "Value of the primary channel.",
            "type": "number"
          }
        }
      }
    }
  },
  "definitions": {
    "SuccessTest": {
      "title": "SuccessTest",
      "description": "The test an experiment must pass, fixed before driving.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "rope",
        "level",
        "better"
      ],
      "properties": {
        "channel": {
          "description": "Metric id of the primary response.",
          "type": "string",
          "minLength": 1
        },
        "rope": {
          "description": "Half-width of the band of effects too small to matter, in the channel's unit.",
          "type": "number",
          "minimum": 0
        },
        "level": {
          "description": "Confidence level of the interval.",
          "type": "number",
          "exclusiveMinimum": 0.5,
          "exclusiveMaximum": 1
        },
        "better": {
          "description": "Which direction is an improvement.",
          "type": "string",
          "enum": [
            "lower",
            "higher"
          ]
        }
      }
    }
  }
}
